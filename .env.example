# نمونهٔ متغیرهای محیطی — این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید.
# .env در .gitignore است و هرگز نباید کامیت شود.

# --- پایه ---
# در اجرای محلی مقدار true (پیش‌فرض) بگذارید؛ در تولید حتما false.
DJANGO_DEBUG=true

# در تولید الزامی است (حداقل ۵۰ کاراکتر تصادفی). در DEBUG=true خالی باشد کافی است.
DJANGO_SECRET_KEY=

# لیست دامنه‌های مجاز، جداشده با کاما. در تولید الزامی است.
# نمونه: shop.zitro.ir,www.shop.zitro.ir
DJANGO_ALLOWED_HOSTS=

# دامنه‌های معتبر برای CSRF (با پروتکل)، جداشده با کاما.
# نمونه: https://shop.zitro.ir,https://www.shop.zitro.ir
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- امنیت (به‌صورت پیش‌فرض همراه DEBUG=false روشن می‌شوند) ---
# کوکی‌های امن، ریدایرکت HTTPS و HSTS را کنترل می‌کند.
DJANGO_SECURE=

# ریدایرکت همهٔ درخواست‌ها به HTTPS را جداگانه کنترل می‌کند.
DJANGO_SECURE_SSL_REDIRECT=

# مدت HSTS به ثانیه (پیش‌فرض در حالت امن: ۳۱۵۳۶۰۰۰).
DJANGO_SECURE_HSTS_SECONDS=

# وقتی برنامه پشت پروکسی معکوس اجرا می‌شود true شود.
DJANGO_USE_X_FORWARDED_HOST=
